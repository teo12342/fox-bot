    "typecheck": "tsc --noEmit",
    "package:win": "npm run package:win -w @foxbot/desktop",
    "package:linux": "npm run package:linux -w @foxbot/desktop"
  },
  "devDependencies": {"typescript": "^5.9.3", "tsx": "^4.20.6", "@types/node": "^24.0.0"}
}
