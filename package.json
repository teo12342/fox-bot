{
  "name": "fox-bot", "version": "0.1.0", "private": true,
  "description": "Local AI teammates with a paired Android companion",
  "license": "MIT", "workspaces": ["apps/desktop", "apps/web", "services/signaling", "packages/protocol"],
  "scripts": {
    "dev": "npm run dev -w @foxbot/desktop",
    "build": "npm run build -w @foxbot/protocol && npm run build -w @foxbot/desktop",
